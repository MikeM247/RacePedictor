digraph V2FirstIteration {
  graph [rankdir=TB, bgcolor="#0c1422", pad="0.45", nodesep="0.4", ranksep="0.48", splines=polyline, fontname="DejaVu Sans", fontsize=23, fontcolor="#eef5ff", label="V2 · First iteration\nYour coaching conversation connects the training journey", labelloc=t, dpi=140];
  node [shape=box, style="rounded,filled", fillcolor="#123340", color="#52cddd", fontname="DejaVu Sans", fontsize=14, fontcolor="#eef5ff", penwidth=1.3, margin="0.20,0.15"];
  edge [color="#93a6bf", arrowsize=0.7, fontname="DejaVu Sans", fontsize=10, fontcolor="#c8d5e5"];

  open [label="Open the app", shape=oval, fillcolor="#263247", color="#9ba9bd"];
  home [label="COACH HOME\nRace goal · last training · next training\nSaved conversation and contextual opening"];
  reflect [label="REFLECT ON LAST TRAINING\nDiscuss how it felt\nUse recorded facts and available review"];
  prepare [label="PREPARE FOR NEXT TRAINING\nUnderstand the session and its purpose\nDiscuss wellbeing, time, and questions"];
  chat [label="CONTINUE THE CONVERSATION\nAsk follow-ups or switch topic"];
  activity [label="VIEW ACTIVITY\nExisting activity detail", fillcolor="#263247", color="#9ba9bd"];
  calendar [label="VIEW SESSION OR CALENDAR\nExisting Calendar\nand permitted actions", fillcolor="#263247", color="#9ba9bd"];
  plan [label="VIEW RACE PLAN\nExisting goal and\nplan workflow", fillcolor="#263247", color="#9ba9bd"];
  resume [label="RETURN TO THE SAME CONVERSATION\nKeep selected context; refresh training facts"];
  note [label="Go directly to Calendar or the race plan whenever useful.\nIn iteration one, training changes use the existing explicit forms.\nCyan: Coach experience   ·   Grey: existing product views", shape=plaintext, style="", fontcolor="#b3c3d8", fontsize=11];

  open -> home;
  home -> reflect;
  home -> prepare;
  {rank=same; reflect; prepare;}
  reflect -> chat;
  prepare -> chat;
  chat -> activity;
  chat -> calendar;
  chat -> plan;
  {rank=same; activity; calendar; plan;}
  activity -> resume;
  calendar -> resume;
  plan -> resume;
  resume -> chat [style=dashed, label="Continue", constraint=false];
  resume -> note [style=invis];
}
