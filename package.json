{
  "name": "racepredictor",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @racepredictor/web",
    "build": "npm run build --workspace @racepredictor/web",
    "vercel-build": "npm run db:generate && npm run db:migrate:deploy && npm run build --workspace @racepredictor/web",
    "start": "npm run start --workspace @racepredictor/web",
    "lint": "npm run lint --workspace @racepredictor/web",
    "test:cloud": "npm test --workspace @racepredictor/core && npm run db:test:cloud && npm test --workspace @racepredictor/web && npm run lint --workspace @racepredictor/web",
    "db:generate": "npm run db:generate --workspace @racepredictor/db",
    "db:migrate": "npm run db:migrate --workspace @racepredictor/db",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @racepredictor/db",
    "db:provision-owner": "npm run db:provision-owner --workspace @racepredictor/db",
    "db:reset": "npm run db:reset --workspace @racepredictor/db",
    "db:analyze:local": "npm run db:analyze:local --workspace @racepredictor/db --",
    "db:import:garmin": "npm run db:import:garmin --workspace @racepredictor/db --",
    "db:normalize": "npm run db:normalize --workspace @racepredictor/db --",
    "db:publish:obsidian": "npm run db:publish:obsidian --workspace @racepredictor/db --",
    "db:refresh:local": "npm run db:refresh:local --workspace @racepredictor/db --",
    "sync:local": "npm run db:sync:local --workspace @racepredictor/db --",
    "sync:local:install": "npm run db:install-sync-task --workspace @racepredictor/db --",
    "db:test:local-analytics": "npm run db:test:local-analytics --workspace @racepredictor/db",
    "db:test:local-activities": "npm run db:test:local-activities --workspace @racepredictor/db",
    "db:test:local-coaching": "npm run db:test:local-coaching --workspace @racepredictor/db",
    "db:test:local-pipeline": "npm run db:test:local-pipeline --workspace @racepredictor/db",
    "db:test:local-sync": "npm run db:test:local-sync --workspace @racepredictor/db",
    "db:test:cloud": "npm run db:test:cloud --workspace @racepredictor/db",
    "db:test:obsidian": "npm run db:test:obsidian --workspace @racepredictor/db",
    "db:test:normalize": "npm run db:test:normalize --workspace @racepredictor/db",
    "db:seed": "npm run db:seed --workspace @racepredictor/db --",
    "db:test:seed": "npm run db:test:seed --workspace @racepredictor/db",
    "db:test:contracts": "npm run db:test:contracts --workspace @racepredictor/db",
    "db:test:gate": "npm run db:test:gate --workspace @racepredictor/db"
  }
}
